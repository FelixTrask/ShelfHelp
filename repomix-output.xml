import { supabase } from '@/lib/Supabase';
import { requestForPushNotificationsAsync } from '@/lib/notifications';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { useFocusEffect, useLocalSearchParams, useRouter } from 'expo-router';
import React, { useCallback, useEffect, useState } from 'react';
import { ActivityIndicator, StyleSheet, Text, TouchableOpacity, View } from 'react-native';

type PantryDetail = {
    id: string;
    name: string;
    address: string;
    current_status: 'green' | 'orange' | 'red' | 'unknown';
}

const getStatus = (status: string | undefined) => {
  switch (status) {
    case 'green':
      return { color: '#2e7d32', label: 'Stocked', bg: '#e8f5e9' };
    case 'orange':
      return { color: '#e65100', label: 'Low Stock', bg: '#fff3e0' };
    case 'red':
      return { color: '#c62828', label: 'Empty', bg: '#ffebee' };
    default:
      return { color: '#616161', label: 'Unknown', bg: '#f5f5f5' };
  }
};

const FAVORITES_KEY = '@favorite_pantries';

export default function PantryDetailScreen() {
    const { id } = useLocalSearchParams();
    const router = useRouter();
    const [pantry, setPantry] = useState<PantryDetail | null>(null);
    const [loading, setLoading] = useState(true);
    const [isFavorite, setIsFavorite] = useState(false);
    const [pushToken, setPushToken] = useState<string | null>(null);

    useFocusEffect(
        useCallback(() => {
            if (id) {
            fetchPantry();
            checkIfFavorite();
            }
        }, [id])
    );

    const fetchPantry = async () => {
        try {
            const { data, error } = await supabase
                .from('pantries')
                .select('*')
                .eq('id', id)
                .single();

            if (error) throw error;
            if (data) setPantry(data as PantryDetail);
        } catch (err: any) {
            console.error(err.message);
        } finally {
            setLoading(false);
        }
    };

    const checkIfFavorite = async () => {
        try {
            const storedFavorites = await AsyncStorage.getItem(FAVORITES_KEY);
            if (storedFavorites) {
                const favoritesList: string[] = JSON.parse(storedFavorites);
                setIsFavorite(favoritesList.includes(id as string));
            }
        } catch (error) {
            console.error('Error checking favorites:', error);
        }
    };

    useEffect(() => {
        requestForPushNotificationsAsync().then((token) => setPushToken(token));
    }, []);
    
    const toggleFavorite = async () => {
        try {
            const storedFavorites = await AsyncStorage.getItem(FAVORITES_KEY);
            let favoritesList: string[] = storedFavorites ? JSON.parse(storedFavorites) : [];

            if (isFavorite) {
                favoritesList = favoritesList.filter((favID) => favID != id);

                if (pushToken) {
                    await supabase
                        .from('pantry_favorites')
                        .delete()
                        .eq('pantry_id', id)
                        .eq('push_token', pushToken);
                }
            } else {
                favoritesList.push(id as string);

                if (pushToken) {
                    await supabase
                        .from('pantry_favorites')
                        .upsert({ pantry_id: id as string, push_token: pushToken });
                }
            }

            await AsyncStorage.setItem(FAVORITES_KEY, JSON.stringify(favoritesList));
            setIsFavorite(!isFavorite);
        } catch (error) {
            console.error('Error updating favorites:', error);
        }
    };

    if (loading) {
        return (
            <View style={styles.centered}>
                <ActivityIndicator size="large" color="#2e7d32" />
            </View>
        );
    }

    if (pantry == null) {
        return (
            <View style={styles.centered}>
                <Text style={styles.errorText}>Pantry not found.</Text>
            </View>
        );
    }
    
    return (
    <View style={styles.overlay}>
        <View style={styles.card}>
            {/* Header */}
            <View style={styles.header}>
                <View style={styles.titleRow}>
                    <Text style={styles.title} numberOfLines={1}>
                        {pantry?.name}
                    </Text>
                    <TouchableOpacity onPress={toggleFavorite} style={styles.favoritesButton}>
                        <Text style={[styles.starText, isFavorite && styles.starActive]}>
                            {isFavorite ? '★' : '☆'}
                        </Text>
                    </TouchableOpacity>
                </View>
                <TouchableOpacity onPress={() => router.back()} style={styles.closeButton}>
                    <Text style={styles.closeText}>✕</Text>
                </TouchableOpacity>
            </View>

            {/* Body Details */}
            <Text style={styles.address} numberOfLines={2}>
                {pantry?.address}
            </Text>

            <View style={styles.statusRow}>
                <Text style={styles.statusLabel}>Status:</Text>
                <Text style={[styles.statusValue, { color: getStatus(pantry?.current_status).color }]}>
                    {getStatus(pantry?.current_status).label}
                </Text>
            </View>

            <TouchableOpacity
                style={styles.reportButton}
                onPress={() =>
                    router.push({
                        pathname: '/report-status',
                        params: {
                            pantryId: pantry.id,
                            pantryName: pantry.name,
                            currentStatus: getStatus(pantry.current_status).label,
                        },
                    })
                }
            >
                <Text style={styles.doneButtonText}>Report status</Text>
            </TouchableOpacity>

            <TouchableOpacity style={styles.closeActionButton} onPress={() => router.back()}>
                <Text style={styles.closeActionButtonText}>Close</Text>
            </TouchableOpacity>
        </View>
    </View>
    );
}

